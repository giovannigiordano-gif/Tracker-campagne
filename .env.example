# Modello del file .env (questo file va su GitHub, il .env vero NO).
# Copialo in ".env" e compila i valori dopo il segno "=", senza spazi e senza virgolette.

# --- Accesso all'app ---
# Password per entrare nella dashboard (la scegli tu).
APP_PASSWORD=
# Chiave segreta per firmare il cookie di sessione: stringa casuale lunga.
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Chiave per cifrare i token salvati in data/secrets/ (32 byte in base64).
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATTENZIONE: se la cambi, i token già salvati dall'app non si leggono più e vanno reinseriti.
ENCRYPTION_KEY=

# --- GoHighLevel ---
# Token "Private Integration" creato nella vista Agency (scope: locations.readonly).
# Serve solo a elencare i sub-account.
GHL_AGENCY_TOKEN=
# ID dell'agency (Company ID).
GHL_COMPANY_ID=
# Versione API da mandare nell'header "Version" (dalla documentazione ufficiale attuale).
GHL_API_VERSION=v3
# I token dei singoli sub-account si inseriscono dalla pagina Impostazioni dell'app
# e vengono salvati cifrati in data/secrets/. In alternativa (utile in sviluppo)
# si possono mettere qui, uno per riga, con il nome GHL_TOKEN_<LOCATIONID>:
# GHL_TOKEN_abc123XYZ=pit-...

# --- Meta (Marketing API) ---
# Token del System User del Business Manager, con permesso ads_read sugli account dei clienti.
META_SYSTEM_USER_TOKEN=
# Versione della Graph API (la più recente stabile).
META_GRAPH_VERSION=v26.0

# --- Anthropic (analisi AI, Fase 5) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
